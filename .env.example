# Site URL (used for metadata / OpenGraph)
NEXT_PUBLIC_URL="http://localhost:3000"
NODE_ENV="development"

# WakaTime — powers the "coding status" widget in the hero
# Get your key at https://wakatime.com/settings/account
WAKATIME_API_KEY="your-wakatime-api-key"

# Spotify — powers the "last played" widget in the hero (optional)
# See the setup steps to obtain a refresh token
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
SPOTIFY_REFRESH_TOKEN="your-spotify-refresh-token"

# Upstash Redis — powers the footer visitor counter
# Create a free DB at https://console.upstash.com → copy the REST URL + token
UPSTASH_REDIS_REST_URL="your-upstash-rest-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Umami analytics (optional)
NEXT_PUBLIC_UMAMI_SRC="your-umami-script-url"
NEXT_PUBLIC_UMAMI_ID="your-umami-website-id"
